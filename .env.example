# ==========================================
# OpenEazyQ / GampangBot Configuration
# ==========================================

# 1. Telegram Configuration
# Bot token from BotFather (format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram numeric user ID of admin authorized to run /upgrade and /backup
ADMIN_ID=1234567890

# 2. Initial AI Provider Configuration
# OpenAI-compatible or Anthropic endpoint (e.g., https://tokenharbor.ai/v1 or https://api.openai.com/v1)
AI_BASE_URL=https://tokenharbor.ai/v1
AI_API_KEY=your_ai_api_key_here

# Primary model name
AI_MODEL_NAME=deepseek-v4.1-flash:free

# Fallback model name (used if primary fails or times out)
AI_FALLBACK_MODEL_NAME=mimo-v2.6-flash:free

# 3. Server Ports
# Dummy HTTP port for cloud platform health checks (Render, Koyeb, Railway)
PORT=3000

# OpenEazyQ Web Admin Panel port (http://localhost:5050)
PANEL_PORT=5050

# 4. Security & Network (Optional)
# Set to 'true' only if connecting to local AI hosts (e.g., Ollama or vLLM on private IP)
# ALLOW_PRIVATE_AI_HOSTS=false
